#!name=G1 Pro Annual Test (English)
#!desc=v7.6.0 English compatibility entry: Same three-tier G1 ACQ script, limited to /ai? responses; passive collection and diagnostics. Enable only one main module.
#!system=ios

[Rule]
# Block UDP 443 to encourage HTTP/3 fallback to TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-pro-annual-test = type=http-response,pattern=^https:\/\/one\.google\.com\/ai\?,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NightVibes33/g1-acq/main/g1-acq.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/NightVibes33/g1-acq/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
