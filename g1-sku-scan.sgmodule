#!name=G1 SKU Scan (English)
#!desc=Collect candidate SKUs from one.google.com responses without modifying the original response; view and export the local report.
#!system=ios

[Rule]
# Block UDP 443 to encourage HTTP/3 fallback to TCP.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-sku-scan = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/NightVibes33/g1-acq/main/g1-sku-scan.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://raw.githubusercontent.com/NightVibes33/g1-acq/main/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com
